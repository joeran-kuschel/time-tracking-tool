{
  "name": "time-tracking-backend",
  "version": "0.1.0",
  "description": "Time tracking tool API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "extract": "lingui extract --clean"
  },
  "jest": {
    "reporters": [
      "default",
      "<rootDir>/tests/helpers/timingReporter.js"
    ],
    "transform": {
      "\\.m?js$": [
        "babel-jest",
        {
          "plugins": [
            "@babel/plugin-transform-modules-commonjs"
          ],
          "babelrc": false,
          "configFile": false
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(@lingui|@messageformat|content-disposition)/)"
    ]
  },
  "keywords": [],
  "author": "Jöran Kuschel <joeran@joerankuschel.de>",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "@lingui/core": "^6.9.0",
    "@lingui/format-po": "^6.9.1",
    "@lingui/message-utils": "^6.9.1",
    "content-disposition": "^3.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@lingui/cli": "^6.9.0",
    "jest": "^29.7.0",
    "js-yaml": "^5.4.3",
    "nodemon": "^3.0.1",
    "pg-mem": "^3.0.14"
  }
}
