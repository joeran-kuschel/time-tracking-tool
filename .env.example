# Frontend (for the Vite dev server; needs docker-compose.dev.yml for the backend port)
VITE_API_URL=http://localhost:3000/api

# Backend
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://timetracking:password@localhost:5432/time_tracking
# "true" for remote databases that require SSL
DB_SSL=false
# Addresses the frontend is opened at, comma-separated (here: nginx and the Vite dev server)
CORS_ORIGIN=http://localhost,http://localhost:5173

# PostgreSQL
POSTGRES_USER=timetracking
POSTGRES_PASSWORD=password
POSTGRES_DB=time_tracking
